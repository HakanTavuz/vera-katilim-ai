# false = vulnerabilities active, true = all fixes on
SECURE_MODE=false

# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me

# 32 random bytes, base64: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
DATA_ENCRYPTION_KEY=

# leave empty and the assistant answers "API anahtarı tanımlı değil"
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

DATABASE_PATH=securebank.db
